# Get a free key from Google AI Studio, then copy this file to ".env"
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: default model for new conversations
GEMINI_LIVE_MODEL=gemini-3.8-live

# MySQL from XAMPP (these are the XAMPP defaults; the database "gideon" is created for you)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
